# Dependencies — reinstalled inside the image (npm ci / pip install)
node_modules
**/node_modules

# Build output. frontend/build is intentionally NOT ignored: the committed SPA
# build is copied verbatim into the image by the Dockerfile.
dist

# VCS & local tooling
.git
.archive

# Secrets — never into an image
.env
.env.*
**/.env
**/.env.*
backend/serverpytext.txt

# Python runtime artifacts
__pycache__
**/__pycache__
*.pyc
.pytest_cache
*.egg-info

# Logs & local state
logs
**/logs
*.log
