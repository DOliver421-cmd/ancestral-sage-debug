# IMPORTANT: Update this URL whenever the Railway project or custom domain changes.
# If you add a custom domain in Railway, replace the value below with that domain.
# Leaving a stale URL here will break all frontend API calls in production.
#
# DEFAULT: same-origin ("/"). Use this when the backend serves the built React
# SPA and the API lives at /api on the same origin. This is the recommended
# deployment because it requires zero CORS configuration and works automatically.
REACT_APP_BACKEND_URL=/
#
# ALTERNATIVE: explicit backend URL. Uncomment and set when the frontend and
# backend are on different origins (e.g. Vercel frontend + Railway backend).
# REACT_APP_BACKEND_URL=https://arts-and-tech-production.up.railway.app
