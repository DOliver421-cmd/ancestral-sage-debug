server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    # ── API proxy ─────────────────────────────────────────────────────────────
    # Forwards /api/* to the FastAPI backend service.
    # BACKEND_URL  — full URL of the backend (e.g. https://foo.up.railway.app).
    #                Default is an unreachable IP literal (127.0.0.1:9) so nginx
    #                always starts; /api 502s until BACKEND_URL is set.
    # BACKEND_HOST — hostname derived from BACKEND_URL by
    #                docker-entrypoint.d/15-backend-host.envsh (or set explicitly).
    #                Used as the Host header so Railway's load balancer routes it.
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;
        proxy_http_version 1.1;

        # Must match the backend domain — Railway routes by Host header
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Required for HTTPS upstream (Railway public domains use TLS)
        proxy_ssl_server_name on;
        proxy_ssl_verify     off;

        # Allow enough time for LLM-backed endpoints
        proxy_read_timeout    120s;
        proxy_connect_timeout  10s;
        proxy_send_timeout     30s;
    }

    # ── Classic tool assets (/tools/* and /originals/*) ────────────────────
    # These standalone HTML apps are embedded in-app via <iframe>.  Without an
    # explicit header the CDN / proxy layer may send X-Frame-Options:DENY which
    # causes Chrome to show "This content is blocked."  Setting SAMEORIGIN here
    # ensures the same-origin iframe is always allowed while still preventing
    # third-party sites from framing these pages.
    location /tools/ {
        add_header X-Frame-Options "SAMEORIGIN" always;
        try_files $uri =404;
    }

    location /originals/ {
        add_header X-Frame-Options "SAMEORIGIN" always;
        try_files $uri =404;
    }

    # ── Cache policy ──────────────────────────────────────────────────────────
    # index.html must NEVER be cached: it references hashed bundles, and a
    # stale copy is exactly how users end up stuck on an old build (broken
    # auth, dead logo, dead API URLs). Always revalidate it.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        expires -1;
        try_files /index.html =404;
    }

    # The service worker must also revalidate so updated sw.js installs.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files /sw.js =404;
    }

    # Hashed build assets (/static/js/main.<hash>.js) are immutable —
    # they can never change at the same URL, so cache them hard.
    location /static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # ── React SPA ─────────────────────────────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }
}
