# Backend Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ── Required ──────────────────────────────────────────────────────────────
# MongoDB connection string (primary database)
# Example: mongodb://localhost:27017/wai_institute
# Example: mongodb+srv://user:pass@cluster.mongodb.net/wai_institute
MONGO_URL=

# JWT signing secret — MUST be persistent across restarts
# Generate with: openssl rand -hex 32
# WARNING: If not set, server generates an EPHEMERAL secret on each restart,
# which invalidates all existing sessions. Tokens will not persist.
JWT_SECRET=

# ── Optional but Recommended ──────────────────────────────────────────────
# Backup MongoDB connection (Atlas free tier recommended for redundancy)
MONGO_BACKUP_URL=
MONGO_BACKUP_DB=wai

# ── Payments ──────────────────────────────────────────────────────────────
# Stripe secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=

# ── Email ─────────────────────────────────────────────────────────────────
# Resend API key for transactional email
RESEND_API_KEY=

# ── AI Providers ──────────────────────────────────────────────────────────
# Groq API key (free tier available)
GROQ_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Use "*" for development only (disables credentials)
# Example: CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=*

# ── Other ─────────────────────────────────────────────────────────────────
# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Database name (default: wai)
DB_NAME=wai
