# =============================================================================
# WAI PLATFORM — ENVIRONMENT / RAILWAY VARIABLE REFERENCE
#
# Rewritten 2026-08-31. Every name below was extracted from os.environ.get()
# calls in the code that actually runs (server.py, routers/*, ai/llm_gateway.py,
# ai/publishing.py, keyvault.py, cross_site_auth.py).
#
# The previous version of this file was a trap: it listed MONGODB_URI, SUPABASE_*,
# SENDGRID_API_KEY, ENVIRONMENT, DEBUG, LOG_LEVEL, CREATOR_REVENUE_SHARE and
# similar names that belong to backend/config.py — a near-dead layer the running
# app does not use for its live paths. It listed NONE of the variables the app
# actually reads. Following it produced a non-functional deployment.
#
# NOTE ON config.py: backend/config.py reads MONGODB_URI and defaults
# DATABASE_NAME to "wai_institute". The live app reads MONGO_URL and defaults
# DB_NAME to "ancestral_sage". They are DIFFERENT DATABASES. Only the
# scheduled-jobs layer (backend/jobs.py via database.py) uses config.py, and it
# is currently a no-op because db_manager is never connected. Do not "fix" this
# by setting MONGODB_URI — that points the jobs at a second, empty database.
#
# Secrets belong in Railway Variables, never in a committed file.
# .gitignore already blocks .env, .env.*, *.env — keep it that way.
# =============================================================================


# =============================================================================
# REQUIRED — the app will not work correctly without these
# =============================================================================

# --- Database -----------------------------------------------------------------
# If MONGO_URL is unset the app still BOOTS with the database disabled and
# prints "MONGO_URL is not set — database disabled". It does not refuse to start.
MONGO_URL=mongodb://localhost:27017/ancestral_sage
DB_NAME=ancestral_sage

# --- Auth ---------------------------------------------------------------------
# MUST be set and MUST be persistent. If unset the app prints
# "FATAL: JWT_SECRET is not set" and CONTINUES ANYWAY with broken auth.
# A non-persistent value logs every user out on each redeploy.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# --- Executive seat -----------------------------------------------------------
# At least one seat email MUST be set before the site is public.
#
# HOW THE BOOTSTRAP WORKS (routers/auth.py, register handler): on a completely
# empty users collection, a registration is granted executive_admin ONLY if the
# registering address matches one of these seat emails. Any other address gets
# "student". Once a single user exists, the bootstrap closes permanently.
#
# Before 2026-08-31 this check required only that SOME seat email be configured,
# without matching the registrant — so setting these variables ARMED an
# escalation for whoever registered first with any address. Fixed; the email
# must now match. Verify after any change to that handler.
#
# Set the real value in Railway Variables, not here.
EXEC_ADMIN_EMAIL=
BACKUP_EXEC_ADMIN_EMAIL=
NAM_EXEC_EMAIL=

# Seed passwords for the exec seats. If left empty a random password is
# generated at seed time and emailed; if the email send fails it is written to
# the startup log as "TEMP PASSWORD". There are NO hardcoded fallback passwords
# in source. Prefer setting these explicitly so nothing lands in a log.
EXEC_DEFAULT_PASSWORD=
BACKUP_EXEC_DEFAULT_PASSWORD=
NAM_EXEC_DEFAULT_PASSWORD=

# Shared secret for the emergency exec-account reset endpoint.
EXEC_RESET_SECRET=

# --- Key encryption at rest ---------------------------------------------------
# Encrypts provider/BYOK API keys stored in db.api_keys.
# Resolution ladder (backend/keyvault.py): this env var -> a secret persisted in
# db.platform_config -> a per-process EPHEMERAL key. Ephemeral means saved
# provider keys STOP DECRYPTING after a restart. Setting this explicitly is the
# only fully deterministic option.
PROVIDER_KEY_ENCRYPTION_SECRET=

# Encrypts access-denial audit records. If unset the app logs
# "denial records are stored UNENCRYPTED". Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUDIT_ENCRYPTION_KEY=

# --- URLs / CORS --------------------------------------------------------------
# CORS currently defaults to allow_origins=['*']. Pin it to your real origins
# before launch: auth is a bearer token from localStorage, so allow_credentials
# being false does NOT prevent replay from another origin.
CORS_ORIGINS=https://www.wai-institute.org,https://www.morehelp.center
FRONTEND_URL=
PUBLIC_APP_URL=
PUBLIC_BACKEND_URL=
# Railway injects PORT. Do not hardcode it.
# PORT=8001


# =============================================================================
# PAYMENTS — Lemon Squeezy is merchant of record, Gumroad second
# (owner directive; also recorded at routers/payments.py:37-40)
# =============================================================================

# --- Lemon Squeezy (primary MoR) ---------------------------------------------
# The webhook secret is what makes paid orders actually fulfil. Without it
# POST /api/payments/webhook returns 404 and buyers are never granted access.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# --- Gumroad (secondary MoR) -------------------------------------------------
# WARNING: this key enables OUTBOUND publishing only (ai/publishing.py).
# There is currently NO inbound Gumroad webhook, so a Gumroad SALE records no
# order, grants no tier, and fulfils nothing. See REMEDIATION_PLAN.md Part 3.1.
GUMROAD_API_KEY=

# --- Stripe (configured fallback) --------------------------------------------
# All three are needed for a working flow; without the webhook secret the
# checkout succeeds but the order is never recorded.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=


# =============================================================================
# AI PROVIDERS — free-first chain via ai/llm_gateway.py
# At least one is required or /api/health reports "ai_providers_unconfigured".
# Keys may also be entered at runtime via the exec Provider Gateway
# (/admin/providers), which stores them encrypted in db.api_keys.
# =============================================================================
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
HUGGINGFACE_API_KEY=
HF_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_IS_ENABLED=false
GROK_API_KEY=
AI_PROVIDER_DEEPSEEK_KEY=
EMERGENT_LLM_KEY=

# Cost guard. Verify by execution that exhaustion actually DENIES a request —
# an unenforced cap is an unbounded bill.
HOURLY_TOKEN_CAP=


# =============================================================================
# EMAIL — Resend primary, Gmail SMTP fallback (server.py:657-735)
# NOTE: SendGrid is NOT used by this stack, despite "TODO: SendGrid" comments
# still present in backend/jobs.py. Wire those to the sender below.
# =============================================================================
RESEND_API_KEY=
RESEND_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
PLATFORM_NOTIFY_EMAIL=
BUG_REPORT_NOTIFY_EMAIL=


# =============================================================================
# CROSS-SITE SSO (wai-institute.org <-> morehelp.center)
# Both peers share JWT_SECRET and CROSS_SITE_SECRET. Whether the two domains are
# one deployment or two independent ones is NOT declared in this repo — see
# REMEDIATION_PLAN.md / .claude/skills/_shared/REPO-REALITY.md section 0.
# Do not assume the two share a database.
# =============================================================================
CROSS_SITE_SECRET=
WAI_API_BASE=
MORE_API_BASE=


# =============================================================================
# OPTIONAL / OPERATIONAL
# =============================================================================

# Scheduled revenue jobs. OFF by default. Note: as of 2026-08-31 all four jobs
# are no-ops even when enabled, because db_manager is never connected
# (REMEDIATION_PLAN.md Part 3.3). Do not enable expecting payouts to run.
JOBS_ENABLED=false

# Exposes the full endpoint surface publicly. NEVER enable in production.
ENABLE_API_DOCS=0

# Serve the built React SPA from the backend (single-service deployment).
SERVE_FRONTEND=

# Secondary Mongo for the /api/health backup probe. There is NO automatic
# failover in business logic — the primary connection is used everywhere.
MONGO_BACKUP_URL=
MONGO_BACKUP_DB=

# Cultural scout background pipeline.
SCOUT_ENABLED=false
SCOUT_INTERVAL_HOURS=

# Text-to-speech budget guards (ai/persona_tts.py).
TTS_SESSION_CHAR_CAP=
TTS_USER_DAILY_CHAR_CAP=
TTS_BUDGET_ALERT_RATIO=
TTS_BREAKER_FAIL_THRESHOLD=
TTS_BREAKER_WINDOW_S=
TTS_BREAKER_COOLDOWN_S=

# Misc tuning.
PASSWORD_RESET_TTL_MIN=
ANCESTRAL_SAGE_CONSENT_TTL_MIN=
MEMBER_PROJECT_DAILY_RUNS=
MEDIA_CREATOR_SHARE=
SLACK_WEBHOOK_URL=
TWITTER_BEARER_TOKEN=
APP_VERSION=
APP_ENV=

# --- Dev/recovery only — NEVER set these in production ------------------------
# DEV_RETURN_RESET_TOKEN returns password-reset tokens in the API response.
# EXEC_FORCE_RESET_* force-rewrites an exec credential at boot.
# DEV_RETURN_RESET_TOKEN=
# EXEC_FORCE_RESET=
# EXEC_FORCE_RESET_EMAIL=
# EXEC_FORCE_RESET_PASSWORD=
