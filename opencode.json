{
  "$schema": "https://opencode.ai/config.json",

  "username": "morehelp-dev",

"plugin": ["@daytona/opencode"],

  "instructions": ["AGENTS.md"],

  "permission": {
    "bash": {
      "rm *": "deny",
      "rm -rf *": "deny",
      "rm -rf .*": "deny",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "dropdb *": "deny",
      "mongo * --eval \"db.dropDatabase*\"": "deny",
      "git push": "ask",
      "git commit -m *": "allow",
      "git add *": "allow",
      "npm run migrate*": "ask",
      "python -m pytest*": "allow",
      "docker-compose*": "ask",
      "docker *": "ask",
      "npx *": "ask",
      "*": "ask"
    },
    "edit": "allow",
    "read": "allow",
    "task": "ask",
    "external_directory": {
      "C:\\Users\\lenovo\\AppData\\Local\\Temp\\opencode\\**": "allow",
      "*": "ask"
    }
  },

  "command": {
    "simulate": {
      "description": "Historical command retained for investigation only; do not use as a MoreHelp verification gate.",
      "prompt": "cd backend && python3 -m tests.revenue_simulation"
    },
    "test": {
      "description": "Run the MoreHelp critical-path regression tests.",
      "prompt": "cd backend && python3 -m pytest tests/test_critical_paths.py -v"
    },
    "test-all": {
      "description": "Run all available MoreHelp backend tests.",
      "prompt": "cd backend && python3 -m pytest tests/ -v --tb=short"
    },
    "verify": {
      "description": "Run the repository's focused endpoint verification harness.",
      "prompt": "python3 scripts/tools/verify_endpoints.py"
    },
    "doctor": {
      "description": "Run backend diagnostics when the tool exists in this checkout.",
      "prompt": "python3 scripts/tools/backend_doctor.py"
    },
    "seed": {
      "description": "Start the MoreHelp backend server.",
      "prompt": "cd backend && python3 -m server"
    },
    "deploy-sim": {
      "description": "Run Railway deployment simulation when required.",
      "prompt": "cd backend && python3 scripts/tools/deploy_sim.py"
    },
    "clear-lockout": {
      "description": "Clear exec account lockouts (emergency).",
      "prompt": "cd backend && python3 scripts/ops/clear_lockouts.py"
    },
    "reset-password": {
      "description": "Reset an exec account password (emergency).",
      "prompt": "cd backend && python3 scripts/ops/reset_password.py"
    },
    "status": {
      "description": "Show git status + recent log + what's running",
      "prompt": "WriteStatus()"
    }
  },

  "agent": {},

  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },

  "experimental": {
    "primary_tools": ["read", "edit", "glob", "grep", "bash", "task", "write"],
    "mcp_timeout": 60000
  },

  "tool_output": {
    "max_lines": 300,
    "max_bytes": 10240
  },

  "compaction": {
    "auto": true,
    "tail_turns": 20
  }
}
